{
  "redirects": [
    {
      "source": "/:path((?!api(?:/|$)|uploads(?:/|$)).*)",
      "has": [
        {
          "type": "host",
          "value": "vecy-bienes-raices.vercel.app"
        }
      ],
      "destination": "https://vecygroup.com/:path*",
      "statusCode": 301
    }
  ],
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "http://13.140.149.144/api/:path*"
    },
    {
      "source": "/uploads/:path*",
      "destination": "http://13.140.149.144/uploads/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
